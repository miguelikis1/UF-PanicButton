#include <winver.h>

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Panic Button Contributors"
            VALUE "FileDescription", "Ultra-fast Panic Button for Windows 11"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "PanicButton"
            VALUE "OriginalFilename", "PanicButton.exe"
            VALUE "ProductName", "Panic Button"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "LegalCopyright", "Copyright (c) 2026. MIT License."
        END
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "CompanyName", "Colaboradores de Boton del Panico"
            VALUE "FileDescription", "Boton del Panico ultrarrapido para Windows 11"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "PanicButton"
            VALUE "OriginalFilename", "PanicButton.exe"
            VALUE "ProductName", "Boton del Panico"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "LegalCopyright", "Copyright (c) 2026. Licencia MIT."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200, 0x0c0a, 1200
    END
END
